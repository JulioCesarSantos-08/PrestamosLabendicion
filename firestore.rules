
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function perfil() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }
    function admin() {
      return perfil() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == "admin" &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.estado == "activo";
    }
    function empleado() {
      return perfil() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == "empleado" &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.estado == "activo";
    }
    function asignado(id) {
      return empleado() &&
        exists(/databases/$(database)/documents/prestamos/$(id)) &&
        get(/databases/$(database)/documents/prestamos/$(id)).data.empleadoId == request.auth.uid;
    }
    function fondoRuta() {
      return /databases/$(database)/documents/configuracionFondo/principal;
    }

    function prestamoRuta(id) {
      return /databases/$(database)/documents/prestamos/$(id);
    }

    function pagoRuta(id) {
      return /databases/$(database)/documents/pagos/$(id);
    }

    function saldoRuta(id) {
      return /databases/$(database)/documents/saldosPrestamo/$(id);
    }

    function reciboAbonoRuta(id) {
      return /databases/$(database)/documents/recibosAbono/$(id);
    }

    function reciboPrestamoRuta(id) {
      return /databases/$(database)/documents/recibosPrestamo/$(id);
    }

    function disponibleAnterior() {
      return resource.data.get(
        "saldoDisponibleCentavos",
        resource.data.saldoInicialCentavos
      );
    }

    function capitalRecuperado(capital, total, abonado) {
      return int((abonado * capital) / total + 0.5);
    }

    function prestamoNuevoValido(id) {
      let p = getAfter(prestamoRuta(id)).data;
      let r = getAfter(reciboPrestamoRuta(id)).data;
      return !exists(prestamoRuta(id)) &&
        !exists(reciboPrestamoRuta(id)) &&
        p.creadoPor == request.auth.uid &&
        p.creadoEn == request.time &&
        p.entregaConfirmada == true &&
        p.tipoCalculo == "total_pactado_manual" &&
        p.capitalCentavos is int &&
        p.capitalCentavos > 0 &&
        p.totalPactadoCentavos is int &&
        p.totalPactadoCentavos >= p.capitalCentavos &&
        r.prestamoId == id &&
        r.tipo == "entrega_prestamo" &&
        r.capitalCentavos == p.capitalCentavos &&
        r.creadoPor == request.auth.uid &&
        r.creadoEn == request.time;
    }

    function pagoNuevoValido(id) {
      let p = getAfter(pagoRuta(id)).data;
      let l = get(prestamoRuta(p.prestamoId)).data;
      let s = getAfter(saldoRuta(p.prestamoId)).data;
      let anterior = exists(saldoRuta(p.prestamoId))
        ? get(saldoRuta(p.prestamoId)).data.abonadoCentavos
        : 0;
      let r = getAfter(reciboAbonoRuta(id)).data;
      return !exists(pagoRuta(id)) &&
        !exists(reciboAbonoRuta(id)) &&
        p.creadoPor == request.auth.uid &&
        p.creadoEn == request.time &&
        p.montoCentavos is int &&
        p.montoCentavos > 0 &&
        l.capitalCentavos is int &&
        l.totalPactadoCentavos is int &&
        l.totalPactadoCentavos >= l.capitalCentavos &&
        s.prestamoId == p.prestamoId &&
        s.ultimoPagoId == id &&
        s.abonadoCentavos == anterior + p.montoCentavos &&
        s.abonadoCentavos <= l.totalPactadoCentavos &&
        p.saldoPosteriorCentavos ==
          l.totalPactadoCentavos - s.abonadoCentavos &&
        r.prestamoId == p.prestamoId &&
        r.tipo == "abono" &&
        r.montoCentavos == p.montoCentavos &&
        r.creadoPor == request.auth.uid;
    }

    function incrementoCapitalPago(id) {
      let p = getAfter(pagoRuta(id)).data;
      let l = get(prestamoRuta(p.prestamoId)).data;
      let s = getAfter(saldoRuta(p.prestamoId)).data;
      return capitalRecuperado(
        l.capitalCentavos,
        l.totalPactadoCentavos,
        s.abonadoCentavos
      ) - capitalRecuperado(
        l.capitalCentavos,
        l.totalPactadoCentavos,
        s.abonadoCentavos - p.montoCentavos
      );
    }
    match /usuarios/{id} {
      allow get: if admin() || (request.auth != null && request.auth.uid == id);
      allow list: if admin();
      allow create: if request.auth != null && request.auth.uid == id &&
        request.resource.data.rol == "pendiente" &&
        request.resource.data.estado == "pendiente";
      allow update: if admin();
      allow delete: if false;
    }
    match /clientes/{id} {
      allow read: if admin() || (empleado() && resource.data.empleadoId == request.auth.uid);
      allow create, update: if admin();
      allow delete: if false;
    }
    match /prestamos/{id} {
      allow read: if admin() ||
        (empleado() && resource.data.empleadoId == request.auth.uid);

      allow create: if admin() &&
        request.resource.data.creadoPor == request.auth.uid &&
        request.resource.data.creadoEn == request.time &&
        request.resource.data.capitalCentavos is int &&
        request.resource.data.capitalCentavos > 0 &&
        request.resource.data.totalPactadoCentavos is int &&
        request.resource.data.totalPactadoCentavos >=
          request.resource.data.capitalCentavos &&
        getAfter(fondoRuta()).data.ultimoPrestamoId == id &&
        getAfter(fondoRuta()).data.saldoDisponibleCentavos ==
          get(fondoRuta()).data.get(
            "saldoDisponibleCentavos",
            get(fondoRuta()).data.saldoInicialCentavos
          ) - request.resource.data.capitalCentavos;

      allow update: if admin() &&
        request.resource.data.capitalCentavos ==
          resource.data.capitalCentavos &&
        request.resource.data.totalPactadoCentavos ==
          resource.data.totalPactadoCentavos &&
        request.resource.data.creadoPor ==
          resource.data.creadoPor &&
        request.resource.data.creadoEn ==
          resource.data.creadoEn;

      allow delete: if false;
    }
    match /recibosPrestamo/{id} {
      allow read: if admin() || asignado(id);
      allow create: if admin();
      allow update, delete: if false;
    }
    match /prestamoEventos/{id} {
      allow read, create: if admin();
      allow update, delete: if false;
    }
    match /prestamoControl/{id} {
      allow read: if admin() || asignado(id);
      allow create, update: if admin();
      allow delete: if false;
    }
    match /saldosPrestamo/{id} {
      allow get: if admin() || asignado(id);
      allow list: if admin();

      allow create, update: if
        (admin() || asignado(id)) &&
        request.resource.data.prestamoId == id &&
        request.resource.data.ultimoPagoId is string &&
        request.resource.data.abonadoCentavos is int &&
        request.resource.data.abonadoCentavos > 0 &&
        request.resource.data.totalCentavos ==
          get(prestamoRuta(id)).data.totalPactadoCentavos &&
        request.resource.data.abonadoCentavos <=
          request.resource.data.totalCentavos &&
        getAfter(pagoRuta(request.resource.data.ultimoPagoId))
          .data.prestamoId == id &&
        getAfter(pagoRuta(request.resource.data.ultimoPagoId))
          .data.creadoPor == request.auth.uid &&
        getAfter(fondoRuta()).data.ultimoPagoFondoId ==
          request.resource.data.ultimoPagoId;

      allow delete: if false;
    }
    match /pagos/{id} {
      allow read: if admin() ||
        (empleado() && resource.data.creadoPor == request.auth.uid);

      allow create: if
        (admin() || (
          empleado() &&
          asignado(request.resource.data.prestamoId)
        )) &&
        request.resource.data.creadoPor == request.auth.uid &&
        request.resource.data.creadoEn == request.time &&
        request.resource.data.montoCentavos is int &&
        request.resource.data.montoCentavos > 0 &&
        getAfter(saldoRuta(request.resource.data.prestamoId))
          .data.ultimoPagoId == id &&
        getAfter(fondoRuta()).data.ultimoPagoFondoId == id;

      allow update, delete: if false;
    }
    match /recibosAbono/{id} {
      allow read: if admin() ||
        (empleado() && resource.data.creadoPor == request.auth.uid);

      allow create: if
        (admin() || asignado(request.resource.data.prestamoId)) &&
        request.resource.data.creadoPor == request.auth.uid &&
        request.resource.data.tipo == "abono" &&
        request.resource.data.prestamoId ==
          getAfter(pagoRuta(id)).data.prestamoId &&
        request.resource.data.montoCentavos ==
          getAfter(pagoRuta(id)).data.montoCentavos &&
        getAfter(fondoRuta()).data.ultimoPagoFondoId == id;

      allow update, delete: if false;
    }
        match /gastos/{id} {
      allow read: if admin();

      allow create: if admin() &&
        request.resource.data.keys().hasOnly([
          "concepto", "categoria", "importeCentavos",
          "fecha", "medio", "empleadoId", "vehiculo",
          "nota", "estado", "motivoAnulacion",
          "creadoPor", "creadoEn",
          "actualizadoPor", "actualizadoEn"
        ]) &&
        request.resource.data.keys().hasAll([
          "concepto", "categoria", "importeCentavos",
          "fecha", "medio", "empleadoId", "vehiculo",
          "nota", "estado", "motivoAnulacion",
          "creadoPor", "creadoEn",
          "actualizadoPor", "actualizadoEn"
        ]) &&
        request.resource.data.estado == "activo" &&
        request.resource.data.motivoAnulacion == "" &&
        request.resource.data.creadoPor == request.auth.uid &&
        request.resource.data.actualizadoPor == request.auth.uid &&
        request.resource.data.creadoEn == request.time &&
        request.resource.data.actualizadoEn == request.time &&
        request.resource.data.importeCentavos is int &&
        request.resource.data.importeCentavos > 0 &&
        request.resource.data.importeCentavos <= 10000000000 &&
        request.resource.data.concepto is string &&
        request.resource.data.concepto.size() >= 3 &&
        request.resource.data.concepto.size() <= 120 &&
        request.resource.data.categoria in [
          "Gasolina",
          "Mantenimiento de motos",
          "Sueldos y nómina",
          "Renta",
          "Luz y agua",
          "Internet y teléfono",
          "Papelería e insumos",
          "Seguros y trámites",
          "Otros"
        ] &&
        request.resource.data.fecha is string &&
        request.resource.data.fecha.matches(
          "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        ) &&
        request.resource.data.medio in [
          "efectivo", "transferencia", "tarjeta"
        ] &&
        request.resource.data.empleadoId is string &&
        request.resource.data.vehiculo is string &&
        request.resource.data.vehiculo.size() <= 80 &&
        request.resource.data.nota is string &&
        request.resource.data.nota.size() <= 500;

      allow update: if admin() &&
        resource.data.estado == "activo" &&
        request.resource.data.keys().hasAll(
          resource.data.keys()
        ) &&
        request.resource.data.creadoPor ==
          resource.data.creadoPor &&
        request.resource.data.creadoEn ==
          resource.data.creadoEn &&
        request.resource.data.actualizadoPor ==
          request.auth.uid &&
        request.resource.data.actualizadoEn ==
          request.time &&
        request.resource.data.importeCentavos is int &&
        request.resource.data.importeCentavos > 0 &&
        request.resource.data.importeCentavos <= 10000000000 &&
        request.resource.data.concepto is string &&
        request.resource.data.concepto.size() >= 3 &&
        request.resource.data.concepto.size() <= 120 &&
        request.resource.data.categoria in [
          "Gasolina",
          "Mantenimiento de motos",
          "Sueldos y nómina",
          "Renta",
          "Luz y agua",
          "Internet y teléfono",
          "Papelería e insumos",
          "Seguros y trámites",
          "Otros"
        ] &&
        request.resource.data.fecha is string &&
        request.resource.data.medio in [
          "efectivo", "transferencia", "tarjeta"
        ] &&
        request.resource.data.empleadoId is string &&
        request.resource.data.vehiculo is string &&
        request.resource.data.vehiculo.size() <= 80 &&
        request.resource.data.nota is string &&
        request.resource.data.nota.size() <= 500 &&
        (
          (
            request.resource.data.estado == "activo" &&
            request.resource.data.motivoAnulacion == "" &&
            request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly([
                "concepto", "categoria", "importeCentavos",
                "fecha", "medio", "empleadoId", "vehiculo",
                "nota", "actualizadoPor", "actualizadoEn"
              ])
          ) ||
          (
            request.resource.data.estado == "anulado" &&
            request.resource.data.motivoAnulacion is string &&
            request.resource.data.motivoAnulacion.size() >= 5 &&
            request.resource.data.motivoAnulacion.size() <= 300 &&
            request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly([
                "estado", "motivoAnulacion",
                "actualizadoPor", "actualizadoEn"
              ])
          )
        );

      allow delete: if false;
    }
    match /configuracionFondo/{id} {
      function movimientoAjusteValido() {
        let ruta = /databases/$(database)/documents/movimientosFondo/$(request.resource.data.ultimoAjusteFondoId);
        let movimiento = getAfter(ruta).data;
        let anterior = resource.data.get(
          "saldoDisponibleCentavos",
          resource.data.saldoInicialCentavos
        );
        let ajustes = resource.data.get("ajustesCapitalCentavos", 0);
        let cambio = movimiento.tipo == "aporte"
          ? movimiento.montoCentavos
          : -movimiento.montoCentavos;

        return !exists(ruta)
          && movimiento.creadoPor == request.auth.uid
          && movimiento.creadoEn == request.time
          && movimiento.tipo in ["aporte", "retiro"]
          && movimiento.montoCentavos is int
          && movimiento.montoCentavos > 0
          && movimiento.saldoAnteriorCentavos == anterior
          && movimiento.saldoNuevoCentavos == anterior + cambio
          && movimiento.capitalAnteriorCentavos ==
            resource.data.saldoInicialCentavos + ajustes
          && movimiento.capitalNuevoCentavos ==
            resource.data.saldoInicialCentavos + ajustes + cambio
          && request.resource.data.saldoDisponibleCentavos ==
            movimiento.saldoNuevoCentavos
          && request.resource.data.ajustesCapitalCentavos ==
            ajustes + cambio;
      }

      allow update: if id == "principal" && admin()
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            "saldoDisponibleCentavos",
            "ajustesCapitalCentavos",
            "ultimoAjusteFondoId"
          ])
        && request.resource.data.ultimoAjusteFondoId is string
        && request.resource.data.saldoDisponibleCentavos is int
        && request.resource.data.ajustesCapitalCentavos is int
        && request.resource.data.saldoDisponibleCentavos >= 0
        && request.resource.data.saldoDisponibleCentavos <= 1000000000000
        && request.resource.data.saldoInicialCentavos +
           request.resource.data.ajustesCapitalCentavos > 0
        && request.resource.data.saldoInicialCentavos +
           request.resource.data.ajustesCapitalCentavos <= 1000000000000
        && movimientoAjusteValido();
      allow get: if id == "principal" && (admin() || empleado());
      allow list: if false;

      allow create: if id == "principal" && admin() &&
        request.resource.data.keys().hasOnly([
          "saldoInicialCentavos", "abiertoEn", "creadoPor"
        ]) &&
        request.resource.data.keys().hasAll([
          "saldoInicialCentavos", "abiertoEn", "creadoPor"
        ]) &&
        request.resource.data.saldoInicialCentavos is int &&
        request.resource.data.saldoInicialCentavos > 0 &&
        request.resource.data.saldoInicialCentavos <= 1000000000000 &&
        request.resource.data.abiertoEn == request.time &&
        request.resource.data.creadoPor == request.auth.uid;

      allow update: if id == "principal" &&
        request.resource.data.saldoDisponibleCentavos is int &&
        request.resource.data.saldoDisponibleCentavos >= 0 &&
        request.resource.data.saldoDisponibleCentavos <= 1000000000000 &&
        (
          (
            admin() &&
            request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly([
                "saldoDisponibleCentavos", "ultimoPrestamoId"
              ]) &&
            request.resource.data.ultimoPrestamoId is string &&
            prestamoNuevoValido(
              request.resource.data.ultimoPrestamoId
            ) &&
            request.resource.data.saldoDisponibleCentavos ==
              disponibleAnterior() -
              getAfter(
                prestamoRuta(request.resource.data.ultimoPrestamoId)
              ).data.capitalCentavos
          ) ||
          (
            (admin() || empleado()) &&
            request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly([
                "saldoDisponibleCentavos", "ultimoPagoFondoId"
              ]) &&
            request.resource.data.ultimoPagoFondoId is string &&
            pagoNuevoValido(
              request.resource.data.ultimoPagoFondoId
            ) &&
            (
              admin() ||
              asignado(
                getAfter(
                  pagoRuta(request.resource.data.ultimoPagoFondoId)
                ).data.prestamoId
              )
            ) &&
            request.resource.data.saldoDisponibleCentavos ==
              disponibleAnterior() +
              incrementoCapitalPago(
                request.resource.data.ultimoPagoFondoId
              )
          )
        );

      allow delete: if false;
    }
        match /movimientosFondo/{id} {
      allow get, list: if admin();

      allow create: if admin()
        && request.resource.data.keys().hasOnly([
          "tipo", "montoCentavos",
          "saldoAnteriorCentavos", "saldoNuevoCentavos",
          "capitalAnteriorCentavos", "capitalNuevoCentavos",
          "nota", "creadoPor", "creadoEn"
        ])
        && request.resource.data.keys().hasAll([
          "tipo", "montoCentavos",
          "saldoAnteriorCentavos", "saldoNuevoCentavos",
          "capitalAnteriorCentavos", "capitalNuevoCentavos",
          "nota", "creadoPor", "creadoEn"
        ])
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.creadoEn == request.time
        && request.resource.data.tipo in ["aporte", "retiro"]
        && request.resource.data.montoCentavos is int
        && request.resource.data.montoCentavos > 0
        && request.resource.data.nota is string
        && request.resource.data.nota.size() >= 5
        && request.resource.data.nota.size() <= 150
        && getAfter(
          /databases/$(database)/documents/configuracionFondo/principal
        ).data.ultimoAjusteFondoId == id
        && getAfter(
          /databases/$(database)/documents/configuracionFondo/principal
        ).data.saldoDisponibleCentavos ==
          request.resource.data.saldoNuevoCentavos
        && getAfter(
          /databases/$(database)/documents/configuracionFondo/principal
        ).data.saldoInicialCentavos +
        getAfter(
          /databases/$(database)/documents/configuracionFondo/principal
        ).data.ajustesCapitalCentavos ==
          request.resource.data.capitalNuevoCentavos;

      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

