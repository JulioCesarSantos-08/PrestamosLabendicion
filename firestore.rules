
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function perfil() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }
    function admin() {
      return perfil() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == "admin" &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.estado == "activo";
    }
    function empleado() {
      return perfil() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == "empleado" &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.estado == "activo";
    }
    function asignado(id) {
      return empleado() &&
        exists(/databases/$(database)/documents/prestamos/$(id)) &&
        get(/databases/$(database)/documents/prestamos/$(id)).data.empleadoId == request.auth.uid;
    }
    match /usuarios/{id} {
      allow get: if admin() || (request.auth != null && request.auth.uid == id);
      allow list: if admin();
      allow create: if request.auth != null && request.auth.uid == id &&
        request.resource.data.rol == "pendiente" &&
        request.resource.data.estado == "pendiente";
      allow update: if admin();
      allow delete: if false;
    }
    match /clientes/{id} {
      allow read: if admin() || (empleado() && resource.data.empleadoId == request.auth.uid);
      allow create, update: if admin();
      allow delete: if false;
    }
    match /prestamos/{id} {
      allow read: if admin() || (empleado() && resource.data.empleadoId == request.auth.uid);
      allow create, update: if admin();
      allow delete: if false;
    }
    match /recibosPrestamo/{id} {
      allow read: if admin() || asignado(id);
      allow create: if admin();
      allow update, delete: if false;
    }
    match /prestamoEventos/{id} {
      allow read, create: if admin();
      allow update, delete: if false;
    }
    match /prestamoControl/{id} {
      allow read: if admin() || asignado(id);
      allow create, update: if admin();
      allow delete: if false;
    }
    match /saldosPrestamo/{id} {
      allow get: if admin() || asignado(id);
      allow list: if admin();
      allow create, update: if admin() || (
        asignado(id) &&
        request.resource.data.prestamoId == id &&
        request.resource.data.abonadoCentavos is int &&
        request.resource.data.abonadoCentavos > 0 &&
        request.resource.data.abonadoCentavos <=
          get(/databases/$(database)/documents/prestamos/$(id)).data.totalPactadoCentavos &&
        request.resource.data.totalCentavos ==
          get(/databases/$(database)/documents/prestamos/$(id)).data.totalPactadoCentavos &&
        (!exists(/databases/$(database)/documents/saldosPrestamo/$(id)) ||
          request.resource.data.abonadoCentavos > resource.data.abonadoCentavos)
      );
      allow delete: if false;
    }
    match /pagos/{id} {
      allow read: if admin() || (empleado() && resource.data.creadoPor == request.auth.uid);
      allow create: if admin() || (
        asignado(request.resource.data.prestamoId) &&
        request.resource.data.creadoPor == request.auth.uid &&
        request.resource.data.montoCentavos is int &&
        request.resource.data.montoCentavos > 0
      );
      allow update, delete: if false;
    }
    match /recibosAbono/{id} {
      allow read: if admin() || (empleado() && resource.data.creadoPor == request.auth.uid);
      allow create: if admin() || (
        asignado(request.resource.data.prestamoId) &&
        request.resource.data.creadoPor == request.auth.uid &&
        request.resource.data.tipo == "abono"
      );
      allow update, delete: if false;
    }
        match /gastos/{id} {
      allow read: if admin();

      allow create: if admin() &&
        request.resource.data.keys().hasOnly([
          "concepto", "categoria", "importeCentavos",
          "fecha", "medio", "empleadoId", "vehiculo",
          "nota", "estado", "motivoAnulacion",
          "creadoPor", "creadoEn",
          "actualizadoPor", "actualizadoEn"
        ]) &&
        request.resource.data.keys().hasAll([
          "concepto", "categoria", "importeCentavos",
          "fecha", "medio", "empleadoId", "vehiculo",
          "nota", "estado", "motivoAnulacion",
          "creadoPor", "creadoEn",
          "actualizadoPor", "actualizadoEn"
        ]) &&
        request.resource.data.estado == "activo" &&
        request.resource.data.motivoAnulacion == "" &&
        request.resource.data.creadoPor == request.auth.uid &&
        request.resource.data.actualizadoPor == request.auth.uid &&
        request.resource.data.creadoEn == request.time &&
        request.resource.data.actualizadoEn == request.time &&
        request.resource.data.importeCentavos is int &&
        request.resource.data.importeCentavos > 0 &&
        request.resource.data.importeCentavos <= 10000000000 &&
        request.resource.data.concepto is string &&
        request.resource.data.concepto.size() >= 3 &&
        request.resource.data.concepto.size() <= 120 &&
        request.resource.data.categoria in [
          "Gasolina",
          "Mantenimiento de motos",
          "Sueldos y nómina",
          "Renta",
          "Luz y agua",
          "Internet y teléfono",
          "Papelería e insumos",
          "Seguros y trámites",
          "Otros"
        ] &&
        request.resource.data.fecha is string &&
        request.resource.data.fecha.matches(
          "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        ) &&
        request.resource.data.medio in [
          "efectivo", "transferencia", "tarjeta"
        ] &&
        request.resource.data.empleadoId is string &&
        request.resource.data.vehiculo is string &&
        request.resource.data.vehiculo.size() <= 80 &&
        request.resource.data.nota is string &&
        request.resource.data.nota.size() <= 500;

      allow update: if admin() &&
        resource.data.estado == "activo" &&
        request.resource.data.keys().hasAll(
          resource.data.keys()
        ) &&
        request.resource.data.creadoPor ==
          resource.data.creadoPor &&
        request.resource.data.creadoEn ==
          resource.data.creadoEn &&
        request.resource.data.actualizadoPor ==
          request.auth.uid &&
        request.resource.data.actualizadoEn ==
          request.time &&
        request.resource.data.importeCentavos is int &&
        request.resource.data.importeCentavos > 0 &&
        request.resource.data.importeCentavos <= 10000000000 &&
        request.resource.data.concepto is string &&
        request.resource.data.concepto.size() >= 3 &&
        request.resource.data.concepto.size() <= 120 &&
        request.resource.data.categoria in [
          "Gasolina",
          "Mantenimiento de motos",
          "Sueldos y nómina",
          "Renta",
          "Luz y agua",
          "Internet y teléfono",
          "Papelería e insumos",
          "Seguros y trámites",
          "Otros"
        ] &&
        request.resource.data.fecha is string &&
        request.resource.data.medio in [
          "efectivo", "transferencia", "tarjeta"
        ] &&
        request.resource.data.empleadoId is string &&
        request.resource.data.vehiculo is string &&
        request.resource.data.vehiculo.size() <= 80 &&
        request.resource.data.nota is string &&
        request.resource.data.nota.size() <= 500 &&
        (
          (
            request.resource.data.estado == "activo" &&
            request.resource.data.motivoAnulacion == "" &&
            request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly([
                "concepto", "categoria", "importeCentavos",
                "fecha", "medio", "empleadoId", "vehiculo",
                "nota", "actualizadoPor", "actualizadoEn"
              ])
          ) ||
          (
            request.resource.data.estado == "anulado" &&
            request.resource.data.motivoAnulacion is string &&
            request.resource.data.motivoAnulacion.size() >= 5 &&
            request.resource.data.motivoAnulacion.size() <= 300 &&
            request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly([
                "estado", "motivoAnulacion",
                "actualizadoPor", "actualizadoEn"
              ])
          )
        );

      allow delete: if false;
    }
    match /configuracionFondo/{id} {
      allow get: if id == "principal" && admin();
      allow list: if false;
      allow create: if id == "principal" && admin() &&
        request.resource.data.keys().hasOnly([
          "saldoInicialCentavos", "abiertoEn", "creadoPor"
        ]) &&
        request.resource.data.keys().hasAll([
          "saldoInicialCentavos", "abiertoEn", "creadoPor"
        ]) &&
        request.resource.data.saldoInicialCentavos is int &&
        request.resource.data.saldoInicialCentavos > 0 &&
        request.resource.data.saldoInicialCentavos <= 1000000000000 &&
        request.resource.data.abiertoEn == request.time &&
        request.resource.data.creadoPor == request.auth.uid;
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}



